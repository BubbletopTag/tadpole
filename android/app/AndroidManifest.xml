<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="org.tadpole.view"
          android:versionCode="5" android:versionName="0.2-beta">
    <!-- BUMP THIS WHEN SOMETHING THE PLATFORM CACHES ABOUT THE APP CHANGES.
         Android evaluates 16 KB page compatibility once per package version and
         remembers the verdict: after the libraries were re-linked aligned, the
         same "not 16 KB compatible" dialog kept appearing over an APK whose
         every LOAD segment was already 0x4000 and which zipalign -c -P 16
         passed. It was answering about version 1. -->

    <!-- ONLINE SYSTEM UPDATE DOWNLOADS THE SYSTEM FILES, and without this it
         cannot open a socket at all — the failure is a bare IOException from
         somewhere deep in the HTTP stack, which reads as "the CDN is down"
         rather than as a missing line in a manifest. The packages come from
         digitalcontent.leapfrog.com; nothing else is contacted. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DECLARED AHEAD OF THE CODE THAT WILL USE IT. The LeapPad2 has a camera
         and a Camera app, and the shim will need a real one behind /dev/video
         to serve it — see android/NOTES-camera.md. Asking for the permission is
         separate from being able to use it, and a permission added later than
         the feature means the first build that needs it fails at runtime with a
         SecurityException rather than at install. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- AND THE MICROPHONE, WHICH IS PART OF THE SAME FEATURE. The Camera app
         records video with sound, and libMicrophone.so opens ALSA capture on
         plughw:0,0 to get it; the firmware has no way to make a silent
         recording. Also used by the microphone widget on its own. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!-- ES 1.1 and not 2.0, which is what SDL's own template declares. The
         viewer's GL is fixed-function because it is replaying the guest's
         GLES1; asking for 2.0 would be asking for something we do not use. -->
    <!-- REAL PATHS, NOT content:// URIs. Tadpole browses the filesystem with
         its own file browser and opens what it finds with fopen(); the firmware
         zip and the .tar game backups are ordinary files the user already has.
         The Storage Access Framework would hand back opaque URIs that nothing
         in the viewer can open. See askForStorage() for the rest of it.

         READ_EXTERNAL_STORAGE is capped at 32 because from API 33 it grants
         nothing but media, and from 30 the real answer is MANAGE_EXTERNAL_
         STORAGE, which is not a dialog but a trip to Settings. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
                     android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <uses-feature android:glEsVersion="0x00010001" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application android:label="Tadpole"
                 android:icon="@mipmap/ic_launcher"
                 android:roundIcon="@mipmap/ic_launcher"
                 android:hardwareAccelerated="true"
                 android:allowBackup="false"
                 android:extractNativeLibs="true"
                 android:debuggable="true">
        <!-- NO TITLE BAR, and it has to come from the theme rather than from
             code: the decor view is inflated before onCreate() gets a chance to
             ask for anything, so requestWindowFeature() after the fact either
             throws or leaves a gap where the bar was. The status and navigation
             bars are a separate matter and are hidden in goFullscreen(). -->
        <activity android:name=".TadpoleActivity"
                  android:exported="true"
                  android:label="Tadpole"
                  android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
                  android:launchMode="singleInstance"
                  android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
                  android:preferMinimalPostProcessing="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
